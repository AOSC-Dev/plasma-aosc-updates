[Global]
IconName=system-software-update
Name=System Update
Name[zh_CN]=系统更新
Comment=System update notifications
Comment[zh_CN]=系统更新通知

[Event/updatesAvailable]
Name=System Update(s) Available
Name[zh_CN]=系统更新可用
Comment=System updates(s) are available for install
Comment[zh_CN]=有软件更新可供安装
Action=Popup

[Event/updateError]
Name=Update Failed
Name[zh_CN]=更新失败
Comment=An error occurred while checking for or installing updates
Comment[zh_CN]=检查或安装更新时发生错误
Action=Popup

[Event/updatesInstalled]
Name=System Updates Installed
Name[zh_CN]=更新已安装
Comment=System updates were successfully installed
Comment[zh_CN]=系统更新已成功安装
Action=Popup
